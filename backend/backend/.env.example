# ==========================================
# AssetIQ Backend Environment Configuration
# ==========================================

# Application Settings
APP_NAME=AssetIQ
APP_ENV=development
DEBUG=true

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=assetiq_db
DB_USER=your_local_postgres_user
DB_PASSWORD=replace_me

# Security & CORS (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173

# Lifecycle & EOL Governance
# Assets with EOL dates within this number of days will be flagged as 'Nearing EOL'
EOL_WARNING_DAYS=90
